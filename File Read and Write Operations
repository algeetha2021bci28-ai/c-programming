#include <stdio.h>

int main() {
    FILE *fptr = fopen("data.txt", "w+");
    if (fptr == NULL) {
        printf("Error opening file!\n");
        return 1;
    }

    fprintf(fptr, "Mid-level C programming language.");
    fseek(fptr, 0, SEEK_SET); // Reset file pointer to beginning

    char ch;
    printf("Reading file: ");
    while ((ch = fgetc(fptr)) != EOF) {
        putchar(ch);
    }
    printf("\n");

    fclose(fptr);
    return 0;
}
