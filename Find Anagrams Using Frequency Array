#include <stdio.h>

int isAnagram(char *str1, char *str2) {
    int count[256] = {0};
    int i = 0;

    while (str1[i] && str2[i]) {
        count[(unsigned char)str1[i]]++;
        count[(unsigned char)str2[i]]--;
        i++;
    }

    if (str1[i] != '\0' || str2[i] != '\0') return 0;

    for (int j = 0; j < 256; j++) {
        if (count[j] != 0) return 0;
    }
    return 1;
}

int main() {
    char w1[] = "listen", w2[] = "silent";
    if (isAnagram(w1, w2)) printf("Anagrams\n");
    else printf("Not Anagrams\n");
    return 0;
}
