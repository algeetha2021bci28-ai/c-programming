#include <stdio.h>
#include <stdlib.h>

int main() {
    int n = 5;
    int *arr = (int *)malloc(n * sizeof(int));
    
    if (arr == NULL) {
        printf("Memory allocation failed!\n");
        return 1;
    }

    float sum = 0;
    for (int i = 0; i < n; i++) {
        arr[i] = (i + 1) * 10; // Assign 10, 20, 30, 40, 50
        sum += arr[i];
    }

    printf("Average: %.2f\n", sum / n);
    free(arr); // Prevent memory leaks
    return 0;
}
