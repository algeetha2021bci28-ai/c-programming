#include <stdio.h>
#define R 2
#define C 3

int main() {
    int matrix[R][C] = {{1, 2, 3}, {4, 5, 6}};
    int transpose[C][R];

    for (int i = 0; i < R; i++) {
        for (int j = 0; j < C; j++) {
            transpose[j][i] = matrix[i][j];
        }
    }

    printf("Transposed Matrix:\n");
    for (int i = 0; i < C; i++) {
        for (int j = 0; j < R; j++) {
            printf("%d ", transpose[i][j]);
        }
        printf("\n");
    }
    return 0;
}
